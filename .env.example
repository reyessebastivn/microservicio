#  INSTRUCCIONES:
#  1. Copia este archivo: cp .env.example .env
#  2. Reemplaza los valores de ejemplo por los reales
#  3. Nunca subas el archivo .env al repositorio
# ─────────────────────────────────────────────────────────────

# ── Base de datos MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=tu_password_segura
MYSQL_ROOT_USERNAME=root
MYSQL_DATABASE=basejoyas

# ── JWT ──────────────────────────────────────────────────────
# Genera una clave larga y aleatoria (mínimo 256 bits)
JWT_SECRET=cambia_esta_clave_por_una_muy_larga_y_aleatoria_1234567890abcdef
